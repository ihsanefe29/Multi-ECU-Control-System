# ============================================================
# IMPORTANT PROJECT FILES THAT SHOULD BE TRACKED
# ============================================================

# Do NOT ignore:
#
# frontend/
# backend/
# can-lab/
# virtual-env/
#
# *.cpp
# *.h
# *.hpp
# *.c
# *.py
# *.sh
# *.resc
# *.repl
# *.json
# *.yaml
# *.yml
# CMakeLists.txt
#
# These are source/configuration files and belong in Git.
# ============================================================